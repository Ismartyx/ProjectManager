<?xml version="1.0" encoding="UTF-8"?>
<plugin xmlns="http://apache.org/cordova/ns/plugins/1.0"
        id="cordova-plugin-mecav-notification"
        version="1.0.0">
    <name>MecavNotification</name>
    <description>Native Android Notification plugin for MecavWS</description>
    <license>MIT</license>

    <js-module src="www/MecavNotification.js" name="MecavNotification">
        <clobbers target="MecavNotification" />
    </js-module>

    <platform name="android">
        <config-file target="res/xml/config.xml" parent="/*">
            <feature name="MecavNotification">
                <param name="android-package" value="com.mechave.ws.MecavNotification" />
            </feature>
        </config-file>

        <config-file target="AndroidManifest.xml" parent="/manifest">
            <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
            <uses-permission android:name="android.permission.VIBRATE" />
            <uses-permission android:name="android.permission.WAKE_LOCK" />
        </config-file>

        <source-file src="src/android/MecavNotification.java" target-dir="src/com/mechave/ws" />
    </platform>
</plugin>
