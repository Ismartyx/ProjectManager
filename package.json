{
  "name": "mechave-ws",
  "version": "1.0.0",
  "description": "Mecav Workshop Project Management System",
  "main": "electron-main.js",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win --x64 --publish never"
  },
  "author": "Mecav Workshop <info@mechave.ir>",
  "license": "ISC",
  "devDependencies": {
    "electron": "^28.2.0",
    "electron-builder": "^24.9.1"
  },
  "build": {
    "appId": "com.mechave.ws",
    "productName": "MechaveWS",
    "publish": null,
    "directories": {
      "output": "dist"
    },
    "artifactName": "MechaveWS-Setup.${ext}",
    "files": [
      "package.json",
      "index.html",
      "electron-main.js",
      "css/**/*",
      "js/**/*",
      "fonts/**/*",
      "icon-192.png",
      "icon-512.png",
      "icon.ico",
      "favicon.svg",
      "manifest.json",
      "sw.js"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MechaveWS"
    }
  }
}
